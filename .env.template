# =============================================================================
# CLAIRVOYANT ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (Required)
# -----------------------------------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/[your-project]/settings/api

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (Required)
# -----------------------------------------------------------------------------
# Get these from: https://console.cloud.google.com/apis/credentials
#
# Required OAuth scopes (configure in Google Cloud Console):
#   - https://www.googleapis.com/auth/calendar.readonly
#   - https://www.googleapis.com/auth/gmail.readonly
#   - https://www.googleapis.com/auth/gmail.compose
#   - https://www.googleapis.com/auth/userinfo.email
#   - https://www.googleapis.com/auth/userinfo.profile
#
# Add redirect URI in Google Console:
#   - https://[your-project-ref].supabase.co/auth/v1/callback

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# -----------------------------------------------------------------------------
# LOCAL STORAGE ENCRYPTION (Required)
# -----------------------------------------------------------------------------
# Generate a random 32-character string for encrypting local electron-store
# Command: openssl rand -hex 16

STORE_ENCRYPTION_KEY=your-32-character-encryption-key

# -----------------------------------------------------------------------------
# USER-PROVIDED API KEYS
# -----------------------------------------------------------------------------
# NOTE: Users enter their own API keys in the app's Settings UI.
# The following keys are stored in the user's Supabase profile, NOT here.
#
# - Anthropic API Key (required for AI features)
#   Get from: https://console.anthropic.com/settings/keys
#
# - Notion API Key (optional, for calendar sync)
#   Get from: https://www.notion.so/my-integrations
#
# Users will be prompted to enter their keys on first launch.

# -----------------------------------------------------------------------------
# APP CONFIGURATION (Optional)
# -----------------------------------------------------------------------------

# Deep link protocol for OAuth callback
APP_PROTOCOL=clairvoyant

# Set to 'development' or 'production'
NODE_ENV=development

# Enable debug logging
DEBUG=false
